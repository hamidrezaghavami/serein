# Check for conflicting copies before changing anything.
for old, new in moves.items():
    source, target = root / old, root / new
    if source.exists() and target.exists() and source.read_bytes() != target.read_bytes():
        raise SystemExit(f"Both {old} and {new} exist with different contents. No files changed; review these copies first.")
layout_path = root / "src/app/layout.tsx"
layout = layout_path.read_text()
if '<AuthProvider>' not in layout and '<Storefront>{children}</Storefront>' not in layout:
    raise SystemExit("The layout differs from the reviewed version. No files changed; ask for a layout-specific update.")
if not (root / "src/components/auth-provider.tsx").is_file():
    raise SystemExit("The Clerk components are missing. Extract the complete integration update first.")
package = json.loads((root / "package.json").read_text())
if not package.get("dependencies", {}).get("next"):
    raise SystemExit("This is not the Next.js project root.")

backup = root / ".clerk-repair-backup"
def save_original(path):
    if path.exists():
        destination = backup / (str(path.relative_to(root)) + ".bak")
        if not destination.exists():
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(path, destination)

def write(name, content):
    path = root / name
    if path.exists() and path.read_text() == content:
        return
    save_original(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)

for old, new in moves.items():
    source, target = root / old, root / new
    if source.exists():
        save_original(source)
        target.parent.mkdir(parents=True, exist_ok=True)
        if not target.exists():
            shutil.copyfile(source, target)
        source.unlink()
for folder in [root / "src/tests", root / "src/scripts"]:
    if folder.is_dir() and not any(folder.iterdir()):
        folder.rmdir()

for name, text in FILES.items():
    write(name, text)
if 'import { AuthProvider } from "@/components/auth-provider";' not in layout:
    layout = 'import { AuthProvider } from "@/components/auth-provider";\n' + layout
if '<AuthProvider>' not in layout:
    layout = layout.replace('<Storefront>{children}</Storefront>', '<AuthProvider><Storefront>{children}</Storefront></AuthProvider>', 1)
write("src/app/layout.tsx", layout)

css = (root / "src/app/globals.css").read_text()
if "/* Authentication follows SEREIN's existing ivory and charcoal palette. */" not in css:
    css = css.rstrip() + "\n\n" + AUTH_CSS
css = css.replace("  z-index: 99999;", "  z-index: 2147483647;")
write("src/app/globals.css", css)
package.setdefault("dependencies", {}).update(DEPENDENCIES)
package.setdefault("devDependencies", {}).update(DEV_DEPENDENCIES)
package.setdefault("scripts", {}).update({
    "auth:setup": "node scripts/configure-auth.mjs",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",
})
write("package.json", json.dumps(package, indent=2) + "\n")
ignore = (root / ".gitignore").read_text() if (root / ".gitignore").exists() else ""
if "/.clerk-repair-backup/" not in ignore:
    write(".gitignore", ignore.rstrip() + "\n/.clerk-repair-backup/\n")
print("Clerk paths, routes, provider, dependencies, commands and styles repaired.")
print("Environment files were not read or changed. Source backups end in .bak under .clerk-repair-backup/.")
print("Next run: pnpm install, pnpm typecheck, pnpm test:frontend")
