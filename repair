DEPENDENCIES = {'@clerk/nextjs': '7.9.20', '@clerk/localizations': '4.24.1'}
DEV_DEPENDENCIES = {'vitest': '4.0.18', '@testing-library/react': '16.3.0', '@testing-library/user-event': '14.6.1', '@testing-library/jest-dom': '6.9.1', 'jsdom': '26.1.0'}
moves = {
    "src/scripts/configure-auth.mjs": "scripts/configure-auth.mjs",
    "src/tests/account.test.ts": "tests/frontend/account.test.tsx",
    "src/tests/account.test.tsx": "tests/frontend/account.test.tsx",
    "src/tests/api.test.ts": "tests/frontend/api.test.ts",
